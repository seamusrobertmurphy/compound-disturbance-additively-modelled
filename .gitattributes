04.references/grandfather-study/** filter=lfs diff=lfs merge=lfs -text
04.references/literature/** filter=lfs diff=lfs merge=lfs -text

# Source and documentation must stay diffable text rather than LFS pointers.
# `text` alone is not enough: the broad rules above set filter=lfs, so these
# must unset it with `!filter !diff !merge`.
02.inputs/**/*.R   !filter !diff !merge text
02.inputs/**/*.md  !filter !diff !merge text
02.inputs/**/*.txt !filter !diff !merge text
04.references/**/*.md  !filter !diff !merge text
04.references/**/*.bib !filter !diff !merge text
